    "cypher": [
      {
        "tool": "knowledge_risk",
        "query": "bus_factor",
        "cypher": "// 07 F4 knowledge risk per module: bus factor = number of people who could maintain it.\n// Tuned against the golden set (q09, s03); the plan's rule (score >= 1.0, touched in 180 days)\n// gave graph/src/parser 3 and graph/src/udf 2, because reviews alone (Dvir's 4.5 on parser)\n// and two stray commits (gkorland's 1.3) cleared the bar. A person counts here when:\n//   - authored >= $min_score (0.9, about one commit this week): they wrote code there;\n//     reviewing alone doesn't make you a maintainer\n//   - authored >= $min_share (0.10) of the module's total authored score: a real share,\n//     not a drive-by fix\n//   - last_authored within $window seconds (180 days)\n// Values live in config.py (BUS_FACTOR_*).\n// $repo (repo name, or '' for all) limits the list to one repo's modules (Module.repo).\n// Modules whose total authored score is 0 (only bots or bulk commits) are left out.\n// Order: single points of failure first (1, 2, ...), then dormant modules (bus_factor 0:\n// nobody has authored a real share in the window) at the end, so tiny old modules don't\n// crowd out the risk list.\nMATCH (m:Module)\nWHERE $repo = '' OR m.repo = $repo\nOPTIONAL MATCH (:Person)-[x:EXPERT_IN]->(m)\nWITH m, sum(coalesce(x.authored, 0.0)) AS total\nWHERE total > 0\nOPTIONAL MATCH (p:Person)-[e:EXPERT_IN]->(m)\nWHERE e.authored >= $min_score AND e.authored >= $min_share * total\n  AND e.last_authored > $now - $window\nWITH m, total, p, e ORDER BY e.authored DESC\nWITH m, total,\n     collect(coalesce(p.login, p.name)) AS experts, collect(p.id) AS expert_ids,\n     collect(round(100.0 * e.authored / total)) AS shares\nRETURN m.id AS module_id, m.path AS module, size(experts) AS bus_factor, experts, expert_ids,\n       shares AS share_pct, total AS total_score\nORDER BY CASE WHEN bus_factor = 0 THEN 1 ELSE 0 END, bus_factor ASC, total_score DESC\n",
        "params": {
          "now": 1792218778,
          "min_score": 0.9,
          "min_share": 0.1,
          "window": 15552000,
          "repo": ""
        },
        "rows": 76
      },
      {
        "tool": "knowledge_risk",
        "query": "betweenness",
        "cypher": "// 08 F4 bridge people: betweenness centrality on the COLLABORATES graph.\n// High score = many shortest author/reviewer paths run through this person, so their\n// departure would split the contributor network. samplingSeed is fixed so repeated runs\n// (and the demo) give the same ranking; samplingSize caps the source nodes sampled.\nCALL algo.betweenness({nodeLabels: ['Person'], relationshipTypes: ['COLLABORATES'],\n                       samplingSize: $sampling_size, samplingSeed: $seed})\nYIELD node, score\nWHERE score > 0\nRETURN coalesce(node.login, node.name) AS person, node.id AS id, score\nORDER BY score DESC\nLIMIT $limit\n",
        "params": {
          "limit": 5,
          "sampling_size": 200,
          "seed": 42
        },
        "rows": 5
      },
      {
        "tool": "knowledge_risk",
        "query": "label_propagation",
        "cypher": "// 08 F10 working groups: label propagation (community detection) on COLLABORATES_STRONG\n// (repeat collaborators only; see 08_collaborates_strong for why not plain COLLABORATES).\n// Each person starts with their own label and repeatedly adopts the most common label among\n// their neighbours, so people who review each other end up in one group.\n// Groups of one (isolated people, bots) are dropped.\nCALL algo.labelPropagation({nodeLabels: ['Person'], relationshipTypes: ['COLLABORATES_STRONG']})\nYIELD node, communityId\nWITH communityId, collect(coalesce(node.login, node.name)) AS members, collect(node.id) AS member_ids,\n     count(*) AS size\nWHERE size >= 2\nRETURN communityId AS group_id, size, members, member_ids\nORDER BY size DESC\n",
        "params": {},
        "rows": 2
      }
    ]
