# Copy to .env and fill in. Never commit .env.

# GitHub personal access token (read-only public scopes is enough for fetching;
# write access to the sandbox repo only, for triage comments).
GITHUB_TOKEN=
# Public org whose history is loaded into the demo graph (graph name: lore_<org>).
DEMO_ORG=FalkorDB
# The ONLY repo Lore may write to (owner/repo). Enforced by an allowlist in code.
SANDBOX_REPO=

# FalkorDB connection. Local Docker defaults; set host/password for FalkorDB Cloud.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave empty for local Docker (no auth).
FALKORDB_PASSWORD=

# Two OpenAI-compatible endpoints, one per role (used via the `openai` package with base_url).
# Fast role: cheaper model for bulk extraction (Gemini, OpenAI-compatible endpoint).
LLM_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FAST_API_KEY=
LLM_FAST_MODEL=
# Smart role: Groq; its key also serves the agents' pool.
LLM_SMART_BASE_URL=https://api.groq.com/openai/v1
LLM_SMART_API_KEY=
LLM_SMART_MODEL=
# The agents use a pool of models on these two keys (AGENT_LLM_POOL in backend/lore/config.py).
# Free-tier keys only: never a billing-enabled key.
# Local fastembed model; one model everywhere.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the embedding model; used by the vector indexes.
EMBEDDING_DIM=384
# Hard cap on LLM calls per day (cached calls don't count).
LLM_DAILY_CALL_CAP=2000

# API: browser origins allowed by CORS (comma-separated; the frontend runs on 3001), and the
# per-user limits on /ask (each question spends free-tier LLM calls).
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ASK_PER_MINUTE=5
ASK_PER_DAY=100

# Secret for verifying GitHub webhook signatures from the sandbox repo.
GITHUB_WEBHOOK_SECRET=

# Secret that signs triage approvals (the UI's approve click). post_triage refuses every post
# without a token made from it. Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))".
TRIAGE_APPROVAL_SECRET=

# Steward (M13). DRY_RUN=true: approving a triage draft only prints it. false: post_triage posts the
# comment with GITHUB_TOKEN (still only to SANDBOX_REPO, still only with an approval token).
DRY_RUN=true
# The API checks SANDBOX_REPO for new issues this often (seconds) and lets Steward draft them.
# 0 = off (the deployed backend uses the webhook: POST /webhook/github, GITHUB_WEBHOOK_SECRET).
STEWARD_POLL_SECONDS=60

# Deploy only (deploy/docker-compose.yml): the HTTPS site address Caddy serves, <ip-with-dashes>.sslip.io.
LORE_DOMAIN=
